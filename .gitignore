# Los artefactos viven en modelos/; preparar.py los copia a backend/app/ml/.
backend/app/ml/*.joblib
backend/app/ml/*.pkl
backend/app/ml/*.json

# El dataset se descarga aparte (ver dataset/README.md)
dataset/*.csv
# ...salvo la muestra de ejemplo: la pagina la pide en runtime para la
# pestaña de categorias propias, asi que tiene que estar publicada.
!dataset/muestra_tipo_contenido.csv

# Archivos que generan los notebooks al ejecutarse
notebooks/*.csv
notebooks/*.pkl
notebooks/*.joblib
notebooks/*.png
notebooks/*.md
!notebooks/README.md

__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/
.env

# El modelo de embeddings son 122 MB y no es nuestro: lo publica su autor
# y el servicio lo descarga al arrancar. Ver semantica/descargar_modelo.py
semantica/modelo/

# Artefactos que deja pip al instalar el paquete de NLP en modo editable
*.egg-info/
build/
dist/
